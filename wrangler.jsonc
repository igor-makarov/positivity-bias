{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "positivity-bias",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "NEWS", "class_name": "NewsStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NewsStore"] }],
  "triggers": { "crons": ["7 * * * *"] },
  "ai": { "binding": "AI" },
  "vars": {
    "REWRITE_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "REWRITES_PER_REFRESH": "8"
  },
  "observability": { "enabled": true }
}
