{
  "name": "positivity-bias",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node --test --test-isolation=none test/*.test.ts",
    "check": "npm run typecheck && node scripts/check.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "test:worker": "npm run build && node scripts/smoke.ts",
    "test:extract": "node scripts/extraction-check.ts",
    "test:retirement": "node scripts/retirement-check.ts",
    "test:pipeline": "node scripts/pipeline-check.ts",
    "test:batch": "node scripts/batch-check.ts",
    "test:browser": "npm run test:interaction",
    "test:interaction": "npm run build && node scripts/interaction-check.ts",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json && tsc -p tsconfig.tools.json",
    "build:client": "node scripts/build-client.ts"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/node": "24.19.2",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261006.2-beta",
    "typescript": "^7.0.2",
    "wrangler": "4.150.0"
  }
}
